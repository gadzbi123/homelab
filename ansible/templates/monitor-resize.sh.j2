#!/bin/sh
set -eu

# pixel-frame reads the framebuffer's live width, height, offsets, and stride,
# so it automatically fits a monitor without a fixed HDMI mode. This helper
# makes that state visible and optionally runs a site-specific resize command.
if [ -n '{{ monitor_resize_command }}' ]; then
    sh -c '{{ monitor_resize_command }}'
fi

if command -v fbset >/dev/null 2>&1; then
    fbset -s || true
fi

if [ -n "${DISPLAY:-}" ] && command -v xrandr >/dev/null 2>&1; then
    xrandr --current || true
fi

